# .gitignore file
# yup, this shit works recursively

# ignore sublime-workspace files
*.sublime-workspace

# compiled source
*.com
*.class
*.dll
*.exe
*.[oa]
*.so
*.pyc

# pre-compiled headers
*.h.[gp]ch

# packages
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# logs and databases
*.log
*.sql
*.sqlite

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# my custom ignores
test.*
*.out
*.pdf

# custom for (my)make and other build systems
*.bin

# ignore any test or todo items
test
*.todo.*
